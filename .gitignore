# Data (large, downloaded separately)
data/raw/*
data/interim/*
data/processed/*
.tools/
paper/build/
tmp/pdfs/
data/partitions/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/partitions/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Experiment tracking / results artifacts
mlruns/
mlartifacts/
checkpoints/
models/artifacts/*
results/figures/*.png
results/figures/*.pdf
results/figures/*.svg
results/tables/*.csv
!results/figures/.gitkeep
!results/tables/.gitkeep
results/shap/*
results/shap_local_debug/*

# OS
.DS_Store
Thumbs.db

# Markdown files (ignore all except README)
*.md
!README.md

# Editors
.vscode/
.idea/
